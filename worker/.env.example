# Copy to .env and fill in. NEVER commit .env to git.
# .env me asal keys hoti hain — ye file sirf khaaka (template) hai.

# Supabase project (tumhara apna — Supabase dashboard > Project Settings > API)
SUPABASE_URL=https://xyzcompany.supabase.co
# SERVICE ROLE key — sirf is worker (server) me use hogi, kabhi browser/frontend me NAHI.
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# Har sending account ka Graph token alag env var me (LEGACY manual flow).
# Naya tareeka: dashboard ka "Connect with Microsoft" button — tokens
# per-account DB me save hote hain aur worker khud refresh karta hai.
# Dono chalte hain; DB tokens ko priority milti hai.
GRAPH_TOKEN_ACC1=
ALERT_EMAIL=you@example.com

# Azure app (dashboard OAuth + worker token auto-refresh). Server-only.
# Azure portal → App registrations → Lumina → Overview / Certificates & secrets.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
