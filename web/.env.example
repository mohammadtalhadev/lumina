# Lumina web — env template. PLACEHOLDERS ONLY. Never put real keys here.
# Copy to .env.local and fill in. .env.local is git-ignored.

# Supabase project (Supabase dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-anon-key-here

# Server-only. NEVER prefix with NEXT_PUBLIC_ — that would ship it to browsers.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here

# Python worker base URL (server-only — NEVER NEXT_PUBLIC_).
# Example: http://127.0.0.1:8000  (local) or https://lumina-worker.onrender.com
# The dashboard calls it ONLY through /api/worker/* (whitelisted paths).
WORKER_URL=
