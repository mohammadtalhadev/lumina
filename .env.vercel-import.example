# Lumina — Vercel env import file. VALUES ARE EMPTY ON PURPOSE.
# 1. Fill in the values below (see "where from" notes).
# 2. NEVER commit the filled file to git.
# 3. Vercel → Project → Settings → Environment Variables → "Import .env"
#    → paste the filled contents → Save → Redeploy.
# Do NOT add WORKER_URL — the service binding injects it automatically.

# Supabase dashboard → Project Settings → API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=

# Supabase dashboard → Project Settings → API → "anon public" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase dashboard → Project Settings → API → "service_role" key (SECRET, server-only)
SUPABASE_SERVICE_ROLE_KEY=

# Same Project URL again (the Python worker reads this name)
SUPABASE_URL=

# Same "service_role" key again (the Python worker reads this name)
SUPABASE_SERVICE_KEY=

# Your own email — worker alerts land here
ALERT_EMAIL=

# Any long random string you make up, e.g. from: openssl rand -hex 32
# Must match the Authorization header you set on cron-job.org later.
CRON_SECRET=

# Azure/Outlook OAuth access token — PHASE 0 STEP 3 me add karna.
# Abhi khaali chhor do; baad me Vercel dashboard me manually add kar dena.
# (Naya tareeka: dashboard ka "Connect with Microsoft" button — phir iski
# zaroorat nahi rehti.)
GRAPH_TOKEN_ACC1=

# Azure app credentials ("Connect with Microsoft" button + token auto-refresh).
# Azure portal → App registrations → Lumina → Overview (client ID) /
# Certificates & secrets (client secret). Server-only, kabhi NEXT_PUBLIC_ nahi.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
